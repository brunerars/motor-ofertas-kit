# motor-ofertas — segredos da loja (copie p/ .env e preencha; NUNCA versionar)
# Esta é a PARTE HUMANA do setup: cada valor tem origem clara, preenche 1× por loja.

# 1) Firecrawl (scrape do Mercari) — firecrawl.dev → API Keys
FIRECRAWL_API_KEY=

# 2) Vercel (deploy da LP) — vercel.com/account/tokens
VERCEL_TOKEN=

# 3) Baserow (fila de ofertas)
BASEROW_API_URL=https://baserow.arvsystems.cloud
BASEROW_TOKEN=            # Database Token: Baserow → base → ⋯ → API tokens
BASEROW_DATABASE_ID=104   # id do database (não-segredo; ajuste por loja)
BASEROW_TABLE_ID=556      # id da tabela DISPARADOR (não-segredo)

# 4) Z-API (WhatsApp) — app.z-api.io
ZAPI_INSTANCE=            # ID da instância
ZAPI_TOKEN=              # token da instância
ZAPI_CLIENT_TOKEN=       # Account Security Token (menu da conta → Segurança)
ZAPI_GROUP_ID=           # id do grupo (formato 120363...-group; achar via GET /chats)

# 5) Formulário de garimpo do Caio (garimpo/ → webhook n8n → Baserow)
N8N_WEBHOOK_URL=          # URL pública do webhook no n8n hospedado (ex: https://<n8n>/webhook/nsc-garimpo-8f3a1c)
FORM_SECRET=             # string qualquer; a MESMA vai no form e no node Config do workflow (freio leve de spam)

# 6) WAHA (WhatsApp HTTP API auto-hospedado) — alternativa à Z-API
# ⚠️ O WAHA REGERA essas credenciais a cada start se elas NÃO vierem como env do
#    container. Fixar aqui e passar no compose/stack, senão a API key muda sozinha
#    e o n8n começa a tomar 401 sem motivo aparente.
WAHA_URL=                 # local: http://localhost:3000 · VPS: o n8n usa http://waha:3000 (rede interna, sem domínio)
WAHA_API_KEY=             # header X-Api-Key em toda chamada da API
WAHA_DASHBOARD_USERNAME=  # login do dashboard (onde se escaneia o QR)
WAHA_DASHBOARD_PASSWORD=
WHATSAPP_SWAGGER_USERNAME=
WHATSAPP_SWAGGER_PASSWORD=
# id do grupo no formato WAHA: 120363...@g.us  (a Z-API usa 120363...-group — NÃO são intercambiáveis)
WAHA_GROUP_ID=

# Gemini (imagens dos passos via /nanobanana) — opcional
GEMINI_API_KEY=
