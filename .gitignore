# Segredos — NUNCA versionar
.env
*.env
!.env.example
.credentials.json
bw-jwt.txt
# Cookies de sessão (Instagram/Pinterest p/ yt-dlp e gallery-dl) = credencial viva.
# Quem tem o arquivo entra na conta. O canônico mora FORA de qualquer repo, em
# Desktop/Gerador-Conteudos/Conteudo-Teste/www.instagram.com_cookies.txt
*cookies*.txt
*.cookies

# Workflows n8n COM os segredos preenchidos (espelho do que roda em prod).
# Ficam SÓ na máquina do Bruno: ele exporta de lá / importa direto, sem editar token na mão.
# Os templates versionáveis (com <PREENCHER_...>) continuam em n8n/*.json.
n8n/versoes-em-prod/

# Vercel / build
.vercel/
lp/.vercel/
node_modules/
*.local

# Firecrawl — dumps brutos intermediários
# _raw*.json (não só _raw.json: um 2º scrape do mesmo item vira _raw2.json)
# _upload.json = resposta da API do Baserow ao subir a foto; a URL que importa
# mora no campo photo_url da linha, não aqui.
marca/acervo/**/_raw*.json
marca/acervo/**/_upload.json
lp/**/_raw*.json

# Referência de design (input do /marca, pesada, regenerável — não runtime)
marca/referencia/

# Cache do quality gate (regenerável)
.impeccable/

# Temp / OS / editor
*.tmp
_verify_tmp.html
.DS_Store
Thumbs.db
*.err

# curadoria: o BRUTO do Mercari fica local (foto e dump da Firecrawl sao pesados
# e o coletar.py os regenera). O JULGAMENTO vai pro git: parecer.json, preco.json,
# traducao.json e dados.json custaram ~63k tokens de pericia por peca e nao se
# regeneram. Sao 451 KB contra 28,4 MB de foto.
curadoria/pecas/**/*.jpg
curadoria/pecas/**/raw*.json

# Worktrees do Claude Code: arvore de trabalho, nao codigo-fonte.
# Sao centenas de MB e o conteudo ja vive nas branches do proprio remote.
.claude/worktrees/

__pycache__/
*.pyc

# varredura: o dump bruto da Firecrawl fica local (regeneravel e pesado).
# O cards.json normalizado ENTRA no git: e a serie historica, e sem ela o
# comparavel nasce sem memoria a cada rodada.
curadoria/varredura/**/raw*.json
