{
  "name": "NSC — Dispara Ofertas Aprovadas",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            { "field": "minutes", "minutesInterval": 30 }
          ]
        }
      },
      "id": "b1a10000-0000-4000-8000-000000000001",
      "name": "Agenda (a cada 30min)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [-272, -144]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            { "id": "c1", "name": "baserow_url", "value": "https://baserow.arvsystems.cloud", "type": "string" },
            { "id": "c2", "name": "table_id", "value": "556", "type": "string" },
            { "id": "c3", "name": "baserow_token", "value": "<PREENCHER_BASEROW_TOKEN>", "type": "string" },
            { "id": "c4", "name": "zapi_instance", "value": "<PREENCHER_ZAPI_INSTANCE>", "type": "string" },
            { "id": "c5", "name": "zapi_token", "value": "<PREENCHER_ZAPI_TOKEN>", "type": "string" },
            { "id": "c6", "name": "zapi_client_token", "value": "<PREENCHER_ZAPI_CLIENT_TOKEN>", "type": "string" },
            { "id": "c7", "name": "group_id", "value": "120363429602486219-group", "type": "string" }
          ]
        },
        "options": {}
      },
      "id": "b1a10000-0000-4000-8000-000000000002",
      "name": "Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [-80, -144]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $('Config').item.json.baserow_url }}/api/database/rows/table/{{ $('Config').item.json.table_id }}/?user_field_names=true&size=200",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "=Token {{ $('Config').item.json.baserow_token }}" }
          ]
        },
        "options": {}
      },
      "id": "b1a10000-0000-4000-8000-000000000003",
      "name": "Baserow: listar linhas",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [128, -144]
    },
    {
      "parameters": {
        "jsCode": "// Filtra as ofertas prontas pra disparar (portão de aprovação).\n// Aprovado = sai já · Agendado = só quando scheduled_at venceu.\n// Nunca dispara Fila. Sem photo_url/caption, pula (evita post quebrado).\nconst cfg = $('Config').first().json;\nconst now = new Date().toISOString();\nconst rows = ($input.first().json.results) || [];\nconst out = [];\nfor (const r of rows) {\n  const st = (r.status && r.status.value) ? r.status.value : r.status;\n  const due = st === 'Aprovado' || (st === 'Agendado' && r.scheduled_at && r.scheduled_at <= now);\n  if (!due) continue;\n  if (!r.photo_url || !r.caption) continue;\n  out.push({ json: { row_id: r.id, phone: cfg.group_id, image: r.photo_url, caption: r.caption } });\n}\nreturn out;"
      },
      "id": "b1a10000-0000-4000-8000-000000000004",
      "name": "Filtrar aprovados",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [336, -144]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://api.z-api.io/instances/{{ $('Config').item.json.zapi_instance }}/token/{{ $('Config').item.json.zapi_token }}/send-image",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Client-Token", "value": "={{ $('Config').item.json.zapi_client_token }}" }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "keypair",
        "bodyParameters": {
          "parameters": [
            { "name": "phone", "value": "={{ $json.phone }}" },
            { "name": "image", "value": "={{ $json.image }}" },
            { "name": "caption", "value": "={{ $json.caption }}" }
          ]
        },
        "options": {}
      },
      "id": "b1a10000-0000-4000-8000-000000000005",
      "name": "Z-API: enviar oferta",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [528, -144]
    },
    {
      "parameters": {
        "method": "PATCH",
        "url": "={{ $('Config').item.json.baserow_url }}/api/database/rows/table/{{ $('Config').item.json.table_id }}/{{ $('Filtrar aprovados').item.json.row_id }}/?user_field_names=true",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "=Token {{ $('Config').item.json.baserow_token }}" }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "keypair",
        "bodyParameters": {
          "parameters": [
            { "name": "status", "value": "Disparado" },
            { "name": "posted_at", "value": "={{ $now.toISO() }}" },
            { "name": "wa_message_id", "value": "={{ $json.messageId }}" }
          ]
        },
        "options": {}
      },
      "id": "b1a10000-0000-4000-8000-000000000006",
      "name": "Baserow: marcar Disparado",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [736, -144]
    }
  ],
  "connections": {
    "Agenda (a cada 30min)": { "main": [[{ "node": "Config", "type": "main", "index": 0 }]] },
